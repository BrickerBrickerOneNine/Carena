# Crypto Daytrading Arena - API Keys
# Copy this file to arena.env and fill in your keys:
#   cp arena.env.example arena.env

# LLM Provider (at least one required)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Coinbase Advanced Trade (required for live trading mode)
# Get these from: https://portal.cdp.coinbase.com/access/api
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# Optional overrides
# TRADE_FEE_RATE=0.001
